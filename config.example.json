{
  "tracker": {
    "kind": "jira-acli",
    "site": "example.atlassian.net",
    "project": "PROJ",
    "jql": "project = PROJ AND assignee = currentUser() AND sprint in openSprints() ORDER BY updated DESC",
    "pointsField": "customfield_00000",
    "columns": ["To Do", "In Progress", "Code Review", "Done"],
    "finished": ["Done"],
    "afterMerge": "Done",
    "afterMergeRules": [
      {
        "branch": "^hotfix/",
        "to": null
      }
    ]
  },
  "repo": {
    "path": "~/code/example-app"
  }
}
