{
  "tracker": {
    "kind": "jira-acli",
    "site": "example.atlassian.net",
    "project": "PROJ",
    "jql": "project = PROJ AND assignee = currentUser() AND sprint in openSprints() ORDER BY updated DESC",
    "pointsField": "customfield_00000",
    "columns": ["To Do", "In Progress", "Code Review", "Done"],
    "notStarted": ["To Do"],
    "blocked": ["Blocked"],
    "finished": ["Done"],
    "afterMerge": "Done",
    "afterMergeRules": [
      {
        "branch": "^hotfix/",
        "to": null
      }
    ]
  },
  "repo": {
    "path": "~/code/example-app",
    "remote": "example/example-app",
    "worktreeScript": "./scripts/new-worktree.sh",
    "branch": "{type}/{key}-{slug}",
    "prTitle": "{type}({scope}): {description} ({key})"
  },
  "app": {
    "devCommand": "pnpm dev --port {port} --strictPort",
    "ownerPort": 3000,
    "buildPorts": [3001, 3005]
  }
}
